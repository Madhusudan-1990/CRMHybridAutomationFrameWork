// Dockerised pipeline: the test image ships headless Chrome, so there is no grid
// to start - build the image, run it, publish, push, then trigger the sharded Job.
//
// Prerequisites on the Jenkins agent:
//   - docker
//   - kubectl pointed at the cluster
//   - a registry credential with id "dockerhub" (username + API token)
//   - a jenkins credential with id "crm-credentials" (username + password)
pipeline {
    agent any

    environment {
        REGISTRY   = 'ghcr.io'
        IMAGE      = "ghcr.io/madhusudan-1990/crm-tests"
        TAG        = "${env.BUILD_NUMBER}"
        SUITE_XML  = 'src/test/resources/testrunners/testng_shard.xml'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build image') {
            steps {
                // layer cache keeps the maven dependency download out of the hot path
                sh 'docker build --pull -t $IMAGE:$TAG -t $IMAGE:latest .'
            }
        }

        stage('Smoke test the image') {
            steps {
                // one shard, locally, before anything reaches the cluster
                sh '''
                    docker run --rm \
                      -e ENV=qa -e BROWSER=chrome -e HEADLESS=true \
                      -e CONTAINER=true -e REMOTE=false \
                      -e SHARD_INDEX=0 -e SHARD_COUNT=1 \
                      -e USERNAME="$CRM_USERNAME" -e PASSWORD="$CRM_PASSWORD" \
                      -v "$PWD/reports:/app/tests/reports" \
                      $IMAGE:$TAG
                '''
            }
        }

        stage('Publish reports') {
            steps {
                junit allowEmptyResults: true, testResults: 'surefire-reports/TEST-*.xml'
                allure includeProperties: false, results: [[path: 'allure-results']]
                publishHTML([
                    allowMissing: true,
                    alwaysLinkToLastBuild: true,
                    keepAll: true,
                    reportDir: 'reports',
                    reportFiles: 'TestExecutionReport.html',
                    reportName: 'HTML Regression Extent Report'
                ])
            }
        }

        stage('Push image') {
            when {
                branch 'main'
            }
            steps {
                withCredentials([usernamePassword(credentialsId: 'dockerhub',
                                                  usernameVariable: 'REG_USER',
                                                  passwordVariable: 'REG_PASS')]) {
                    sh '''
                        echo "$REG_PASS" | docker login $REGISTRY -u "$REG_USER" --password-stdin
                        docker push $IMAGE:$TAG
                        docker push $IMAGE:latest
                    '''
                }
            }
        }

        stage('Run sharded suite on kubernetes') {
            when {
                branch 'main'
            }
            steps {
                // an indexed Job, so each of the 4 pods runs a different slice
                sh '''
                    sed -i "s|image: $REGISTRY/madhusudan-1990/crm-tests:1.0|image: $IMAGE:$TAG|" k8s/05-test-job.yaml
                    kubectl -n qa-automation delete job crm-regression --ignore-not-found
                    kubectl apply -f k8s/05-test-job.yaml
                    kubectl -n qa-automation wait --for=condition=complete job/crm-regression --timeout=30m || \\
                    kubectl -n qa-automation wait --for=condition=failed  job/crm-regression --timeout=5m
                    kubectl -n qa-automation logs job/crm-regression --tail=100
                '''
            }
        }
    }

    post {
        always {
            sh 'docker rmi $IMAGE:$TAG 2>/dev/null || true'
        }
        success {
            echo 'Sharded regression suite passed.'
        }
        failure {
            echo 'Check the Extent report for the failed step screenshots.'
        }
    }
}
